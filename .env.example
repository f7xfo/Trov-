# --- Application ---
APP_ENV=development                       # development | production
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://trov:trov@postgres:5432/trov

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- LLM (DeepSeek by default; any OpenAI-compatible endpoint works) ---
LLM_PROVIDER=deepseek                     # deepseek | openai | anthropic | ollama
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1  # change to http://ollama:11434/v1 for local
LLM_MODEL=deepseek-chat
LLM_EMBEDDING_MODEL=text-embedding-3-small  # used for pgvector search

# --- Telegram ---
TELEGRAM_BOT_TOKEN=                       # get from @BotFather
TELEGRAM_WEBHOOK_URL=                     # public HTTPS URL, e.g. https://api.trov.org
TELEGRAM_WEBHOOK_SECRET=changeme          # any random string for webhook verification

# --- Messenger (Phase 2) ---
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=

# --- Security ---
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
